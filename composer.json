{
    "name": "monicahq/laradb",
    "description": "A read-only database browser for Laravel: browse your tables and their rows from a single page. Supports MySQL, PostgreSQL and SQLite.",
    "keywords": [
        "laravel",
        "php",
        "database",
        "db",
        "browser",
        "viewer",
        "mysql",
        "postgresql",
        "sqlite",
        "developer-tools"
    ],
    "type": "library",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/monicahq/laradb/issues",
        "source": "https://github.com/monicahq/laradb"
    },
    "authors": [
        {
            "name": "Regis Freyd"
        },
        {
            "name": "Alexis Saettler",
            "email": "alexis@saettler.org"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-pdo": "*",
        "composer-runtime-api": "^2.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/routing": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/view": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "larastan/larastan": "^2.9|^3.0",
        "laravel/pint": "^1.16",
        "orchestra/testbench": "^8.14|^9.0|^10.0",
        "phpstan/phpstan-deprecation-rules": "^1.1|^2.0",
        "phpstan/phpstan-phpunit": "^1.3|^2.0",
        "phpstan/phpstan-strict-rules": "^1.5|^2.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "LaraDb\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaraDb\\Tests\\": "tests"
        }
    },
    "scripts": {
        "lint": "vendor/bin/pint",
        "test:lint": "vendor/bin/pint --test",
        "test:types": "vendor/bin/phpstan analyse",
        "test:unit": "vendor/bin/phpunit",
        "test": [
            "@test:lint",
            "@test:types",
            "@test:unit"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaraDb\\LaraDbServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "ocramius/package-versions": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
